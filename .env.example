# ============================================
# MAGNETO - Variables de Entorno
# ============================================

# --- IA / API ---
# Opción 1: Groq API (Recomendado - Gratis y rápido)
# Registrate en https://groq.com y obten tu API key
GROQ_API_KEY=

# Opción 2: Lovable AI Gateway (Solo si desplegás con backend Lovable)
LOVABLE_API_KEY=

# --- Supabase (Autenticación y Base de Datos) ---
# Registrate en https://supabase.com (plan gratis)
# Habilita autenticación por email y Google en el dashboard
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Stripe (Pagos Premium) ---
# Registrate en https://stripe.com
# Crea productos y precios para suscripciones mensual y anual
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_WEBHOOK_SECRET=

# --- Configuración de la App ---
# URL pública de la app (importante para redirects de Stripe y Supabase)
# En desarrollo: http://localhost:8080
# En producción: https://tu-dominio.com
APP_URL=http://localhost:8080

# --- Google AdSense (Publicidad en plan gratis) ---
# Opcional: Configura cuando Google apruebe tu sitio
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=

# --- Configuración Adicional ---
# NODE_ENV=development (cámbialo a 'production' en deploy)
NODE_ENV=development
